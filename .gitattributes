# Laravel project - enforce LF line endings for source files
* text=auto eol=lf

# Binary files (don't touch)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# Lock files (can be binary)
composer.lock -diff
package-lock.json -diff
